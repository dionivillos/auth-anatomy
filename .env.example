# Copy to .env and fill in values for local development.

# Database (defaults to a local SQLite file when unset; PostgreSQL from module 4)
DATABASE_URL=sqlite:///./auth-anatomy.db

# Sessions / cookies
SECURE_COOKIES=false

# SMTP (Mailpit locally, module 3+)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@auth-anatomy.local

# JWT (module 5)
JWT_SECRET=

# TOTP secret encryption (module 6, generate with Fernet.generate_key())
TOTP_ENCRYPTION_KEY=

# GitHub OAuth App (module 7)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/login/github/callback

# WebAuthn (module 8)
RP_ID=localhost
RP_NAME=auth-anatomy
ORIGIN=http://localhost:8000
